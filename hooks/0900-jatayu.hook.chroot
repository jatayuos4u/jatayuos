#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
python3 /usr/share/jatayu/configure-image.py
# Fail before creating an ISO if offline installer or input-method prerequisites are absent.
test -x /usr/bin/unsquashfs
mksquashfs /usr/share/jatayu/FAQ.pdf /tmp/jatayu-unpacker-test.squashfs -noappend -processors 1 >/dev/null
unsquashfs -s /tmp/jatayu-unpacker-test.squashfs >/dev/null
rm /tmp/jatayu-unpacker-test.squashfs
test -s /usr/share/applications/org.fcitx.Fcitx5.desktop
grep -q 'InputMethod=/usr/share/applications/org.fcitx.Fcitx5.desktop' /etc/skel/.config/kwinrc
test -s /etc/skel/.config/autostart/org.fcitx.Fcitx5.desktop
sed -i 's/^# *en_IN UTF-8/en_IN UTF-8/;s/^# *hi_IN UTF-8/hi_IN UTF-8/' /etc/locale.gen
locale-gen
update-locale LANG=en_IN.UTF-8 LC_CTYPE=en_IN.UTF-8
# Recommendations are disabled: install and explicitly enable the NTP provider.
# Activation occurs on live/installed boot, not inside this build chroot.
test -f /usr/lib/systemd/system/systemd-timesyncd.service
systemctl enable NetworkManager sddm unattended-upgrades systemd-timesyncd
systemctl disable ssh.service 2>/dev/null || true
plymouth-set-default-theme jatayu
# Calamares' libpwquality check needs a built CrackLib database in the live image.
update-cracklib
test -s /var/cache/cracklib/cracklib_dict.pwd
update-initramfs -u -k all
# Retain package legal notices and record exact shipped sources/versions.
mkdir -p /usr/share/jatayu/notices
dpkg-query -W -f='${binary:Package}\t${Version}\t${source:Package}\t${source:Version}\n' > /usr/share/jatayu/build-package-manifest.tsv
python3 - <<'PY'
from pathlib import Path
import shutil
for f in Path('/usr/share/doc').glob('*/copyright'):
    try: shutil.copyfile(f,Path('/usr/share/jatayu/notices')/(f.parent.name+'.copyright'))
    except FileNotFoundError: pass
PY
# Preserve the installed version's normal modules; replace only the logo.
fastfetch --config none --gen-config /tmp/jatayu-fastfetch-default.json
python3 - <<'FFPY'
import json
from pathlib import Path
p=Path('/tmp/jatayu-fastfetch-default.json')
data=json.loads(p.read_text())
assert data.get('modules'), 'Fastfetch default modules missing'
data['logo']={'type':'file','source':'/usr/share/jatayu/fastfetch-jatayu.txt','color':{'1':'yellow'}}
Path('/etc/skel/.config/fastfetch/config.jsonc').write_text(json.dumps(data,indent=2)+'\n')
p.unlink()
FFPY
fastfetch --config /etc/skel/.config/fastfetch/config.jsonc --pipe > /usr/share/jatayu/fastfetch-smoke.txt
grep -q 'OS:' /usr/share/jatayu/fastfetch-smoke.txt
apt-get clean
